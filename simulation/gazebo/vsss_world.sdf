<?xml version="1.0" ?>
<sdf version="1.12">
  <world name="vsss">
    <physics name="fixed" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>0 0 -1</direction>
    </light>
    <model name="field">
      <static>true</static>
      <link name="surface">
        <collision name="collision"><geometry><box><size>1.5 1.3 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.3 0.02</size></box></geometry>
          <material><diffuse>0.08 0.45 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ball">
      <pose>0 0 0.0315 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.046</mass></inertial>
        <collision name="collision"><geometry><sphere><radius>0.0215</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.0215</radius></sphere></geometry>
          <material><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="top_camera">
      <static>true</static><pose>0 0 2.0 0 1.570796 0</pose>
      <link name="camera_link"><sensor name="camera" type="camera">
        <camera><horizontal_fov>1.0</horizontal_fov><image><width>680</width><height>520</height></image></camera>
        <always_on>true</always_on><update_rate>30</update_rate>
      </sensor></link>
    </model>
    <include><uri>model://vsss_robot</uri><name>blue_0</name><pose>-0.5 0 0.0475 0 0 0</pose></include>
    <include><uri>model://vsss_robot</uri><name>blue_1</name><pose>-0.25 0.25 0.0475 0 0 0</pose></include>
    <include><uri>model://vsss_robot</uri><name>blue_2</name><pose>-0.25 -0.25 0.0475 0 0 0</pose></include>
    <include><uri>model://vsss_robot</uri><name>yellow_0</name><pose>0.5 0 0.0475 0 0 3.141593</pose></include>
    <include><uri>model://vsss_robot</uri><name>yellow_1</name><pose>0.25 0.25 0.0475 0 0 3.141593</pose></include>
    <include><uri>model://vsss_robot</uri><name>yellow_2</name><pose>0.25 -0.25 0.0475 0 0 3.141593</pose></include>
  </world>
</sdf>
